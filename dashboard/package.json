{
  "name": "bitcoin-report-dashboard",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": "24.x"
  },
  "type": "module",
  "scripts": {
    "sync:local": "tsx scripts/download-data.mjs --local",
    "sync:remote": "tsx scripts/download-data.mjs",
    "prepare:data": "tsx scripts/prepare-data.ts",
    "dev": "npm run prepare:data && vite --host 127.0.0.1",
    "build": "tsx scripts/build.ts",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "node scripts/browser-tests.mjs",
    "export:newsletter": "node scripts/export-newsletter-visuals.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/papaparse": "5.5.2",
    "papaparse": "5.7.0",
    "playwright-core": "1.64.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true
  }
}
